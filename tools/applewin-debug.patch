+// game database: what the CPU would read at addr right now, without side effects (soft switches read 0).
+uint8_t GamedbPeek(uint16_t addr)
+{
+	if (addr >= 0xC000 && addr < 0xC100)
+		return 0;
+	if (GetIsMemCacheValid())
+		return mem[addr];
+	if (memreadPageType[addr >> 8] == MEM_FloatingBus || memshadow[addr >> 8] == NULL)
+		return 0;
+	return *(memshadow[addr >> 8] + (addr & 0xff));
+}
+
+// game database: write the RAM behind addr as it is mapped for reading right now. false = not RAM (ROM, I/O).
+bool GamedbPoke(uint16_t addr, uint8_t data)
+{
+	const LPBYTE p = memshadow[addr >> 8];
+	if (p == NULL || (addr >= 0xC000 && addr < 0xD000))
+		return false;
+	const bool inMain = p >= memmain && p < memmain + 0x10000;
+	const bool inAux = p >= memaux && p < memaux + 0x10000;
+	if (!inMain && !inAux)
+		return false;
+	*(p + (addr & 0xff)) = data;
+	if (GetIsMemCacheValid())
+		mem[addr] = data;
+	return true;
+}
+
 uint16_t ReadWordFromMemory(uint16_t addr)
 {
 	return ReadByteFromMemory(addr) | (ReadByteFromMemory(addr + 1) << 8);
