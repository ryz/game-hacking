+
+// ---------------------------------------------------------------------------------------------------------
+// game database hooks (tools/applewin-debug.patch)
+#include "CPU.h"
+#include "CardManager.h"
+#include "Disk.h"
+#include "Harddisk.h"
+#include <filesystem>
+
+uint8_t GamedbPeek(uint16_t addr);
+bool GamedbPoke(uint16_t addr, uint8_t data);
+
+#define GAMEDB_API extern "C" __attribute__((visibility("default")))
+
+GAMEDB_API unsigned retro_gamedb_pc(void)
+{
+    return regs.pc;
+}
+
+// The byte the CPU would read at addr (current banking, ROM included), without side effects.
+GAMEDB_API unsigned retro_gamedb_peek(unsigned addr)
+{
+    return GamedbPeek(addr & 0xFFFF);
+}
+
+// Write RAM at addr as mapped for reading now; 0 = that address is not RAM.
+GAMEDB_API int retro_gamedb_poke(unsigned addr, unsigned value)
+{
+    return GamedbPoke(addr & 0xFFFF, value & 0xFF) ? 1 : 0;
+}
+
+// Put an image into a drive: 0, 1 = floppy drives 1, 2 (slot 6); 2, 3 = hard disks 1, 2 (slot 7).
+// path NULL or "" = take the disk out. Returns 1 on success.
+GAMEDB_API int retro_gamedb_insert(int drive, const char *path, int writeProtected)
+{
+    const common2::RestoreCurrentDirectory restoreChDir;
+    CardManager &cardManager = GetCardMgr();
+    const bool eject = !path || !*path;
+    if (!eject)
+    {
+        ra2::gamedbDiskFolder = std::filesystem::path(path).parent_path().string();
+    }
+    if (drive == DRIVE_1 || drive == DRIVE_2)
+    {
+        Disk2InterfaceCard *card = dynamic_cast<Disk2InterfaceCard *>(cardManager.GetObj(SLOT6));
+        if (!card)
+            return 0;
+        if (eject)
+        {
+            card->EjectDisk(drive);
+            return 1;
+        }
+        return card->InsertDisk(drive, path, writeProtected ? IMAGE_FORCE_WRITE_PROTECTED
+                                                              : IMAGE_USE_FILES_WRITE_PROTECT_STATUS,
+                                IMAGE_DONT_CREATE) == eIMAGE_ERROR_NONE;
+    }
+    HarddiskInterfaceCard *card = dynamic_cast<HarddiskInterfaceCard *>(cardManager.GetObj(SLOT7));
+    if (!card || drive > 3)
+        return 0;
+    if (eject)
+    {
+        card->Unplug(drive - 2);
+        return 1;
+    }
+    return card->Insert(drive - 2, path) ? 1 : 0;
+}
+
+// Write the floppy tracks still held in memory to their image files.
+GAMEDB_API void retro_gamedb_flush(void)
+{
+    Disk2InterfaceCard *card = dynamic_cast<Disk2InterfaceCard *>(GetCardMgr().GetObj(SLOT6));
+    if (card)
+    {
+        card->FlushCurrentTrack(DRIVE_1);
+        card->FlushCurrentTrack(DRIVE_2);
+    }
+}
