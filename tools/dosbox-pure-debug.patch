@@ -142,6 +142,10 @@ public:
 	}
 };
 
+// game-hacking (tools/dosbox-pure-debug.patch): live union drives, for retro_gamedb_flush below
+struct unionDriveImpl;
+static std::vector<unionDriveImpl*> gamedb_union_impls;
+
 struct unionDriveImpl
 {
 	memoryDrive* save_mem;
@@ -162,6 +166,7 @@ struct unionDriveImpl
 		Bit16u bytes_sector; Bit8u sectors_cluster; Bit16u total_clusters; Bit16u free_clusters;
 		over->AllocationInfo(&bytes_sector, &sectors_cluster, &total_clusters, &free_clusters);
 		writable = (free_clusters > 0);
+		gamedb_union_impls.push_back(this);
 		if (save_mem)
 		{
 			under->AllocationInfo(&bytes_sector, &sectors_cluster, &total_clusters, &free_clusters);
@@ -181,6 +186,7 @@ struct unionDriveImpl
 
 	~unionDriveImpl()
 	{
+		for (size_t i = gamedb_union_impls.size(); i--;) if (gamedb_union_impls[i] == this) gamedb_union_impls.erase(gamedb_union_impls.begin() + i);
 		if (dirty)
 			WriteSaveFile((Bitu)this);
 		if (dirty)
@@ -578,6 +584,18 @@ struct unionDriveImpl
 		dirty = true;
 	}
 
+	// game-hacking (tools/dosbox-pure-debug.patch): mark a file written through a handle that is still open, so
+	// retro_gamedb_flush includes it (the core alone only marks a file when it is closed; a game that keeps its
+	// save file open all session had its writes missing from every savestate). Schedules nothing.
+	void GamedbMarkWritten(const char* path)
+	{
+		if (save_file.empty()) return;
+		const Bit32u namecrc = DriveCalculateCRC32((const Bit8u*)path, (size_t)strlen(path));
+		for (Bit32u it : dirty_paths) { if (it == namecrc) { dirty = true; return; } }
+		dirty_paths.push_back(namecrc);
+		dirty = true;
+	}
+
 	void ForceCloseFileAndScheduleSave(DOS_Drive* drv, const char* path, bool isFile)
 	{
 		if (isFile) DriveForceCloseFile(drv, path);
@@ -693,6 +711,7 @@ struct Union_WriteHandle : public DOS_File
 			dos.errorcode = save_errorcode;
 		}
 		if (!dirty) dirty = true;
+		impl->GamedbMarkWritten(name); // game-hacking: see GamedbMarkWritten
 		return real_file->Write(data, size);
 	}
 
@@ -1146,3 +1165,12 @@ Bits unionDrive::UnMount(void) { delete this; return 0;  }
 
 #include <dbp_serialize.h>
 DBP_SERIALIZE_SET_POINTER_LIST(PIC_EventHandler, unionDrive, unionDriveImpl::WriteSaveFile);
+
+// game-hacking (tools/dosbox-pure-debug.patch): write the save ZIP now. The core writes it one emulated second
+// (or more) after the game changed a file; a frontend that stores the written files with a savestate needs them
+// at the moment of the state. Call only while the emulation thread is parked (after retro_gamedb_sync).
+extern "C" __attribute__((visibility("default"))) void retro_gamedb_flush(void)
+{
+	for (unionDriveImpl* impl : gamedb_union_impls)
+		if (impl->dirty && !impl->save_file.empty()) unionDriveImpl::WriteSaveFile((Bitu)impl);
+}
diff --git a/src/gui/render.cpp b/src/gui/render.cpp
index ba60b45..1f1b334 100644
--- a/src/gui/render.cpp
+++ b/src/gui/render.cpp
@@ -855,6 +855,11 @@ void DBPSerialize_Render(DBPArchive& ar)
 	}
 #endif
 
+	// game-hacking (tools/dosbox-pure-debug.patch): a state made at the frame end has the next frame already
+	// started (updating, no line drawn yet). RENDER_Reset below drops that frame, it is then never counted and
+	// the first retro_run after a load emulates two frames: a loaded run is one frame ahead of the run that
+	// made the state. Start the frame again after the reset.
+	const bool gamedb_was_updating = (ar.mode == DBPArchive::MODE_LOAD && render.updating);
 	if (ar.mode == DBPArchive::MODE_LOAD)
 	{
 		if (memcmp(&render.src, loaded_src, sizeof(render.src)))
@@ -870,5 +875,6 @@ void DBPSerialize_Render(DBPArchive& ar)
 		{
 			RENDER_Reset();
 		}
+		if (gamedb_was_updating && !render.updating) RENDER_StartUpdate();
 	}
 }
