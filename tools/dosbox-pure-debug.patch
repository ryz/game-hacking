diff --git a/dosbox_pure_libretro.cpp b/dosbox_pure_libretro.cpp
index ea24d45..05230ac 100644
--- a/dosbox_pure_libretro.cpp
+++ b/dosbox_pure_libretro.cpp
@@ -4139,3 +4139,18 @@ unsigned DBP_Build_GL_Program(int vertex_shader_srcs_count, const char** vertex_
 	}
 	return prog;
 }
+
+// Added by game-hacking (tools/dosbox-pure-debug.patch): wait until the emulation thread has finished the frame
+// started by the last retro_run. The core lets that thread run ahead while the frontend is busy, so input
+// events and memory reads would otherwise land at a point that depends on host timing.
+extern "C" __attribute__((visibility("default"))) void retro_gamedb_sync(void)
+{
+	if (dbp_state == DBPSTATE_FIRST_FRAME || dbp_state == DBPSTATE_RUNNING) DBP_ThreadControl(TCM_FINISH_FRAME);
+}
+
+// Added by game-hacking (tools/dosbox-pure-debug.patch): 1 while a DOS program runs (the only time the core
+// saves and loads states), 0 in the start menu and at the DOS prompt.
+extern "C" __attribute__((visibility("default"))) int retro_gamedb_running(void)
+{
+	return ((dbp_state == DBPSTATE_FIRST_FRAME || dbp_state == DBPSTATE_RUNNING) && dbp_game_running) ? 1 : 0;
+}
diff --git a/gamedb_debug.cpp b/gamedb_debug.cpp
new file mode 100644
index 0000000..ca9e28a
--- /dev/null
+++ b/gamedb_debug.cpp
@@ -0,0 +1,51 @@
+// Added by game-hacking (tools/dosbox-pure-debug.patch): a clock the frontend sets, and the program counter.
+// The linker wraps time/gettimeofday/clock_gettime/localtime (-Wl,--wrap), so the emulated PC's date, BIOS
+// tick counter and RTC follow retro_gamedb_set_time instead of the host: the same route gives the same game.
+#include <time.h>
+#include <sys/time.h>
+#include <stdint.h>
+#include "include/dosbox.h"
+#include "include/regs.h"
+#include "include/paging.h"
+
+static int64_t gamedb_usec; // 0 = host clock
+
+extern "C" {
+time_t __real_time(time_t*);
+int __real_gettimeofday(struct timeval*, void*);
+int __real_clock_gettime(clockid_t, struct timespec*);
+struct tm* __real_localtime(const time_t*);
+
+__attribute__((visibility("default"))) void retro_gamedb_set_time(int64_t usec) { gamedb_usec = usec; }
+// One byte of the physical address space through the machine's page handlers, so that video memory
+// (A0000-BFFFF) and ROM are readable too. Meant for text modes (B8000): reads of planar graphics memory
+// go through the VGA read latches, which the game can see.
+__attribute__((visibility("default"))) uint8_t retro_gamedb_readb(uint32_t phys)
+{
+	PageHandler* h = MEM_GetPageHandler(phys >> 12);
+	if (h->flags & PFLAG_READABLE) return h->GetHostReadPt(phys >> 12)[phys & 0xFFF];
+	return (uint8_t)h->readb(phys);
+}
+__attribute__((visibility("default"))) uint32_t retro_gamedb_pc(void) { return ((uint32_t)SegValue(cs) << 16) | (reg_eip & 0xFFFF); }
+
+time_t __wrap_time(time_t* t)
+{
+	if (!gamedb_usec) return __real_time(t);
+	time_t r = (time_t)(gamedb_usec / 1000000);
+	if (t) *t = r;
+	return r;
+}
+int __wrap_gettimeofday(struct timeval* tv, void* tz)
+{
+	if (!gamedb_usec) return __real_gettimeofday(tv, tz);
+	if (tv) { tv->tv_sec = gamedb_usec / 1000000; tv->tv_usec = gamedb_usec % 1000000; }
+	return 0;
+}
+int __wrap_clock_gettime(clockid_t id, struct timespec* ts)
+{
+	if (!gamedb_usec) return __real_clock_gettime(id, ts);
+	if (ts) { ts->tv_sec = gamedb_usec / 1000000; ts->tv_nsec = (gamedb_usec % 1000000) * 1000; }
+	return 0;
+}
+struct tm* __wrap_localtime(const time_t* t) { return gamedb_usec ? gmtime(t) : __real_localtime(t); }
+}
diff --git a/src/dos/drive_union.cpp b/src/dos/drive_union.cpp
index 08ec043..7878107 100644
--- a/src/dos/drive_union.cpp
