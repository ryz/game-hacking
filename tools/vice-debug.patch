+/* gamedb (tools/vice-debug.patch): autostart's progress is not in a snapshot: the frontend keeps it, so a
+ * state saved while a game is still being loaded and started goes on the same way. buf NULL: size only. */
+int autostart_gamedb_state(unsigned char *buf, int set)
+{
+    int mode = (int)autostartmode;
+    unsigned char *p = buf;
+    int n = (int)(17 * sizeof(int) + sizeof(CLOCK) + sizeof(unsigned int) + sizeof(size_t) + 256);
+    if (!buf) {
+        return n;
+    }
+#define GD(x) do { if (set) { memcpy(&(x), p, sizeof(x)); } else { memcpy(p, &(x), sizeof(x)); } p += sizeof(x); } while (0)
+    GD(mode);
+    GD(orig_drive_true_emulation_state);
+    GD(orig_device_traps_state);
+    GD(orig_bus_device_state);
+    GD(orig_warp_mode);
+    GD(orig_FileSystemDevice8);
+    GD(orig_FSDevice8ConvertP00);
+    GD(orig_FSDeviceLongNames);
+    GD(handle_drive_true_emulation_overridden);
+    GD(handle_drive_true_emulation_by_machine);
+    GD(autostart_enabled);
+    GD(autostart_wait_for_reset);
+    GD(entered_rom);
+    GD(trigger_monitor);
+    GD(autostart_disk_unit);
+    GD(autostart_disk_drive);
+    GD(autostart_type);
+    GD(autostart_initial_delay_cycles);
+    GD(autostart_run_mode);
+    GD(tap_initial_raw_offset);
+#undef GD
+    if (set) {      /* the program name autostart types (LOAD"NAME",8,1); 255 characters at most, "" = none */
+        autostartmode = mode;
+        lib_free(autostart_program_name);
+        autostart_program_name = p[0] ? lib_strdup((const char *)p + 1) : NULL;
+    } else {
+        memset(p, 0, 256);
+        if (autostart_program_name) {
+            p[0] = 1;
+            strncpy((char *)p + 1, autostart_program_name, 254);
+        }
+    }
+    return n;
+}
