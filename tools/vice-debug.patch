+
+/* ---- gamedb additions (tools/vice-debug.patch): memory, program counter, disks, random state ---- */
+#include "lib.h"
+
+/* 0000-FFFF: what the CPU sees now (ROM, I/O and cartridge banking followed; I/O read without side effects);
+ * 10000-1FFFF: the 64K RAM as stored, whatever is mapped over it. */
+unsigned retro_gamedb_peek(unsigned addr)
+{
+   if (addr >= 0x10000 && addr < 0x20000)
+      return mem_ram[addr - 0x10000];
+   return mem_bank_peek(0, (uint16_t)addr, NULL);
+}
+
+/* 0000-FFFF: a write as the CPU does it (RAM, the RAM under ROM, I/O registers); 10000-1FFFF: RAM. */
+int retro_gamedb_poke(unsigned addr, unsigned value)
+{
+   if (addr >= 0x10000 && addr < 0x20000)
+      mem_ram[addr - 0x10000] = (uint8_t)value;
+   else if (addr < 0x10000)
+      mem_bank_poke(0, (uint16_t)addr, (uint8_t)value, NULL);
+   else
+      return 0;
+   return 1;
+}
+
+extern unsigned int reg_pc;
+unsigned retro_gamedb_pc(void)
+{
+   return reg_pc & 0xffff;
+}
+
+/* Disk into drive unit 8-11 (path NULL = take it out). 1 = done. */
+int retro_gamedb_insert(int unit, const char *path)
+{
+   if (unit < 8 || unit > 11)
+      return 0;
+   if (!path)
+   {
+      file_system_detach_disk(unit, 0);
+      return 1;
+   }
+   return file_system_attach_disk(unit, 0, path) == 0;
+}
+
+/* Write what the drives changed on their disks to the image files now. */
+void retro_gamedb_flush(void)
+{
+   drive_gcr_data_writeback_all();
+}
+
+/* 1 until the content is started: the first-frame restart pending, autostart loading, or its typed text
+ * (LOAD, RUN) not consumed yet. */
+int retro_gamedb_busy(void)
+{
+   return request_restart || autostart_in_progress() || !kbdbuf_queue_is_empty();
+}
+
+/* State outside VICE's snapshots that changes what the machine does next: the shared random generator (CIA,
+ * SID, keyboard delays, ...), drive 8's speed wobble and rotation model (the simple one, or the full circuit
+ * simulation for G64 and any disk once written to; a snapshot load always switched to the full one), the
+ * keyboard queue, the joystick values, autostart's progress with the text it types, and the restart a new core
+ * does on its first frame. The frontend stores it next to each state (retro_gamedb_hidden_*). */
+extern int keyboard_gamedb_state(unsigned char *buf, int set);
+extern int joystick_gamedb_state(unsigned char *buf, int set);
+extern int kbdbuf_gamedb_state(unsigned char *buf, int set);
+extern int autostart_gamedb_state(unsigned char *buf, int set);
+
+static int gamedb_hidden(unsigned char *buf, int set)
+{
+   drive_t *drive = diskunit_context[0]->drives[0];
+   uint64_t rnd;
+   int n = 8 + 12;
+   if (buf)
+   {
+      if (set)
+      {
+         memcpy(&rnd, buf, 8);
+         lib_rand_set_state(rnd);
+         memcpy(&drive->wobble_sin_count, buf + 8, 4);
+         memcpy(&drive->wobble_factor, buf + 12, 4);
+         memcpy(&drive->complicated_image_loaded, buf + 16, 4);
+      }
+      else
+      {
+         rnd = lib_rand_get_state();
+         memcpy(buf, &rnd, 8);
+         memcpy(buf + 8, &drive->wobble_sin_count, 4);
+         memcpy(buf + 12, &drive->wobble_factor, 4);
+         memcpy(buf + 16, &drive->complicated_image_loaded, 4);
+      }
+   }
+   n += keyboard_gamedb_state(buf ? buf + n : NULL, set);
+   n += joystick_gamedb_state(buf ? buf + n : NULL, set);
+   n += kbdbuf_gamedb_state(buf ? buf + n : NULL, set);
+   n += autostart_gamedb_state(buf ? buf + n : NULL, set);
+   if (buf)
+   {
+      /* the restart (autostart of the content) a just-loaded core does on its first frame */
+      if (set)
+      {
+         request_restart = buf[n] != 0;
+         runstate = buf[n + 1];
+      }
+      else
+      {
+         buf[n] = request_restart ? 1 : 0;
+         buf[n + 1] = (unsigned char)runstate;
+      }
+   }
+   n += 2;
+   return n;
+}
+
+int retro_gamedb_hidden_size(void)
+{
+   return gamedb_hidden(NULL, 0);
+}
+
+void retro_gamedb_hidden_get(unsigned char *buf)
+{
+   gamedb_hidden(buf, 0);
+}
+
+void retro_gamedb_hidden_set(const unsigned char *buf)
+{
+   gamedb_hidden((unsigned char *)buf, 1);
+}
