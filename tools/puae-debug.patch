+#ifdef __LIBRETRO__
+#include "zarchive.h"
+/* gamedb (tools/puae-debug.patch): flush the image files of all drives (writes are buffered by the VFS). */
+void gamedb_disk_flush(void)
+{
+	for (int i = 0; i < MAX_FLOPPY_DRIVES; i++) {
+		if (floppy[i].diskfile && floppy[i].diskfile->f)
+			fflush(floppy[i].diskfile->f);
+	}
+}
+#endif
