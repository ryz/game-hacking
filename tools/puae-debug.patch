+#ifdef __LIBRETRO__
+/* gamedb (tools/puae-debug.patch): a savestate names the disk images by full path, but every machine of the
+ * driver works on private copies in its own folder. With a folder set, a restore takes the image of the same
+ * name from that folder. */
+static TCHAR gamedb_disk_dir[MAX_DPATH];
+
+void gamedb_set_disk_dir(const TCHAR *dir)
+{
+	_tcsncpy(gamedb_disk_dir, dir ? dir : _T(""), MAX_DPATH - 1);
+}
+
+static TCHAR *gamedb_remap(TCHAR *s)
+{
+	if (!s || !s[0] || !gamedb_disk_dir[0])
+		return s;
+	const TCHAR *b = _tcsrchr(s, '/');
+	TCHAR *n = xmalloc(TCHAR, MAX_DPATH);
+	snprintf(n, MAX_DPATH, "%s/%s", gamedb_disk_dir, b ? b + 1 : s);
+	xfree(s);
+	return n;
+}
+#endif
