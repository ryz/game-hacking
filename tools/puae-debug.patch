+/* ---- gamedb additions (tools/puae-debug.patch): memory, program counter, disks and clock for the
+ * headless driver tools/lrcore.py. */
+#include "newcpu.h"
+
+static int64_t gamedb_usec = -1;
+
+/* Emulated wall clock in microseconds (Unix time), set by the driver every frame. The battery-backed clock
+ * (cia.c) reads it instead of the host's time(). */
+void retro_gamedb_set_time(int64_t usec)
+{
+   gamedb_usec = usec;
+}
+
+time_t gamedb_time(void)
+{
+   return gamedb_usec < 0 ? time(NULL) : (time_t)(gamedb_usec / 1000000);
+}
+
+unsigned retro_gamedb_pc(void)
+{
+   return m68k_getpc();
+}
+
+/* Host pointer for one byte of the 68k address space: RAM (and ROM for reading) only. Custom chips, CIAs
+ * and unmapped space give NULL, so a peek never has side effects. */
+static uae_u8 *gamedb_xlate(unsigned addr, bool write)
+{
+   addrbank *ab = &get_mem_bank(addr);
+   if (ab->flags & ABFLAG_IO)
+      return NULL;
+   if (!(ab->flags & (write ? ABFLAG_RAM : (ABFLAG_RAM | ABFLAG_ROM))))
+      return NULL;
+   if (!ab->check || !ab->xlateaddr || !ab->check(addr, 1))
+      return NULL;
+   return ab->xlateaddr(addr);
+}
+
+/* The byte with bit 8 set, or 0 when the address is not RAM or ROM. */
+unsigned retro_gamedb_peek(unsigned addr)
+{
+   uae_u8 *p = gamedb_xlate(addr, false);
+   return p ? 0x100 | *p : 0;
+}
+
+int retro_gamedb_poke(unsigned addr, unsigned value)
+{
+   uae_u8 *p = gamedb_xlate(addr, true);
+   if (!p)
+      return 0;
+   *p = (uae_u8)value;
+   return 1;
+}
+
+/* Put an image file into floppy drive 0-3 (path NULL or "" = take the disk out). Like a person swapping
+ * disks: the drive reports the change after the usual delay. */
+int retro_gamedb_insert(int drive, const char *path)
+{
+   if (drive < 0 || drive > 3)
+      return 0;
+   if (!path || !*path)
+      disk_eject(drive);
+   else
+      disk_insert(drive, path);
+   return 1;
+}
+
+/* The folder that holds this machine's disk images: a loaded savestate takes its disks from there. */
+extern void gamedb_set_disk_dir(const char *dir);
+void retro_gamedb_disk_dir(const char *dir)
+{
+   gamedb_set_disk_dir(dir);
+}
+
+/* Write what the game has written to the disk images out to the files now. */
+extern void gamedb_disk_flush(void);
+void retro_gamedb_flush(void)
+{
+   gamedb_disk_flush();
+}
